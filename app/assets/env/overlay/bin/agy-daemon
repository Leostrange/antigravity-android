#!/usr/bin/env python3
"""
agy-daemon - Ultra-lightweight background scheduler, watcher & task manager for Antigravity (AGY v2).
Zero emojis. Ultra-low RAM footprint (<10MB). 0.0% idle CPU.
Runs smoothly with screen off under Android foreground service partial wakelock.

Triggers supported:
  --delay <duration>        Run task after delay (e.g. 4h, 30m, 10s)
  --interval <duration>     Run task periodically (e.g. 15m, 1h)
  --cron "<5-field cron>"   Standard cron schedule (e.g. "0 3 * * *")
  --github-pr <owner/repo>  Watch GitHub repository for new pull requests
  --github-issue <owner/repo> Watch GitHub repository for new issues
  --watch-file <path>       Trigger task whenever file or directory changes
  --battery-below <percent> Trigger task when battery falls below percentage
  --webhook-port <port>     Start a lightweight HTTP webhook receiver for incoming triggers
  --wake-app                Bring Antigravity workspace to foreground upon completion
"""

import sys
import os
import time
import json
import signal
import argparse
import secrets

# Ensure overlay/lib is in python path
_SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
_OVERLAY_LIB = os.path.normpath(os.path.join(_SCRIPT_DIR, "..", "lib"))
if _OVERLAY_LIB not in sys.path:
    sys.path.insert(0, _OVERLAY_LIB)

from daemon.scheduler import (
    matches_cron,
    parse_duration,
    daemon_loop,
    read_daemon_pid,
)
from daemon.triggers import (
    check_github_repo,
    check_file_watcher,
    check_battery_condition,
    start_webhook_listener,
)
from daemon.executor import (
    log,
    notify,
    wake_antigravity_app,
    execute_action_async,
    load_tasks,
    save_tasks,
    CONFIG_DIR,
    TASKS_FILE,
    LOG_FILE,
    PID_FILE,
    STOP_EVENT,
    TASK_EXECUTOR,
    RUNNING_JOBS,
    RUNNING_LOCK,
)


def is_our_daemon(pid):
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            command_line = f.read().replace(b"\0", b" ").decode("utf-8", errors="replace")
        return os.path.realpath(__file__) in command_line or os.path.basename(__file__) in command_line
    except (OSError, PermissionError):
        return False


def request_stop(_signum=None, _frame=None):
    STOP_EVENT.set()


# -----------------------------------------------------------------------------
# Process Daemonization (Forking)
# -----------------------------------------------------------------------------
def get_running_pid():
    if not os.path.isfile(PID_FILE):
        return None
    try:
        with open(PID_FILE, "r") as f:
            pid = int(f.read().strip())
        os.kill(pid, 0)
        return pid
    except (ValueError, OSError):
        return None


def daemonize():
    """Double-fork to fully detach process as a true background POSIX daemon."""
    try:
        pid = os.fork()
        if pid > 0:
            sys.exit(0)
    except OSError as e:
        sys.stderr.write(f"Fork #1 failed: {e}\n")
        sys.exit(1)

    os.setsid()
    os.umask(0)

    try:
        pid = os.fork()
        if pid > 0:
            sys.exit(0)
    except OSError as e:
        sys.stderr.write(f"Fork #2 failed: {e}\n")
        sys.exit(1)

    sys.stdout.flush()
    sys.stderr.flush()

    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(PID_FILE, "w") as f:
        f.write(str(os.getpid()))

    # Redirect stdin/stdout/stderr
    with open("/dev/null", "r") as dev_null:
        os.dup2(dev_null.fileno(), sys.stdin.fileno())
    log_fd = open(LOG_FILE, "a", encoding="utf-8")
    os.dup2(log_fd.fileno(), sys.stdout.fileno())
    os.dup2(log_fd.fileno(), sys.stderr.fileno())

    def sig_handler(signum, frame):
        log(f"Daemon received signal {signum}. Shutting down...")
        TASK_EXECUTOR.shutdown(wait=False)
        try:
            if os.path.isfile(PID_FILE):
                os.remove(PID_FILE)
        except Exception:
            pass
        sys.exit(0)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)

    daemon_loop()


def cmd_start(args):
    existing_pid = get_running_pid()
    if existing_pid:
        print(f"[agy-daemon] Daemon is already running (PID: {existing_pid}).")
        return

    if getattr(args, "foreground", False):
        print(f"[agy-daemon] Running in foreground (PID: {os.getpid()}). Press Ctrl+C to exit.")
        os.makedirs(CONFIG_DIR, exist_ok=True)
        with open(PID_FILE, "w") as f:
            f.write(str(os.getpid()))
        try:
            daemon_loop()
        finally:
            if os.path.isfile(PID_FILE):
                os.remove(PID_FILE)
    else:
        print("[agy-daemon] Starting background daemon...")
        daemonize()


def cmd_stop(args):
    existing_pid = get_running_pid()
    if not existing_pid:
        if os.path.isfile(PID_FILE):
            os.remove(PID_FILE)
        print("[agy-daemon] Daemon is not running.")
        return

    print(f"[agy-daemon] Stopping daemon (PID: {existing_pid})...")
    try:
        os.kill(existing_pid, signal.SIGTERM)
        for _ in range(15):
            time.sleep(0.2)
            try:
                os.kill(existing_pid, 0)
            except OSError:
                break
        else:
            print("[agy-daemon] Force killing unresponsive daemon...")
            os.kill(existing_pid, signal.SIGKILL)
    except Exception as e:
        print(f"[agy-daemon] Error terminating process: {e}")

    if os.path.isfile(PID_FILE):
        try:
            os.remove(PID_FILE)
        except Exception:
            pass
    print("[agy-daemon] Daemon stopped.")


def cmd_status(args):
    pid = get_running_pid()
    tasks = load_tasks()
    active_count = sum(1 for t in tasks if t.get("enabled", True))
    print("--------------------------------------------------")
    print(" Antigravity Autonomous Background Daemon (v2)")
    print("--------------------------------------------------")
    if pid:
        print(f"Status:       RUNNING (PID: {pid})")
    else:
        print("Status:       STOPPED")
    print(f"Tasks:        {active_count} active / {len(tasks)} total")
    print(f"Config Dir:   {CONFIG_DIR}")
    print(f"Tasks File:   {TASKS_FILE}")
    print(f"Log File:     {LOG_FILE}")
    print("--------------------------------------------------")
    if os.path.isfile(LOG_FILE):
        print("Recent logs:")
        try:
            with open(LOG_FILE, "r", encoding="utf-8") as f:
                lines = f.readlines()
                for line in lines[-5:]:
                    print("  " + line.rstrip())
        except Exception:
            pass


# -----------------------------------------------------------------------------
# AI Task Manager Operations
# -----------------------------------------------------------------------------
def cmd_task_add(args):
    tasks = load_tasks()
    task_id = f"task_{int(time.time() * 1000) % 1000000}"
    trigger = {}

    if args.delay:
        delay_sec = parse_duration(args.delay)
        trigger = {
            "type": "delay",
            "run_at": time.time() + delay_sec,
            "delay_sec": delay_sec
        }
    elif args.interval:
        interval_sec = parse_duration(args.interval)
        trigger = {
            "type": "interval",
            "interval_sec": interval_sec,
            "last_run": time.time()
        }
    elif args.cron:
        trigger = {
            "type": "cron",
            "cron": args.cron.strip(),
            "last_cron_min": 0
        }
    elif args.github_pr:
        trigger = {
            "type": "github_pr",
            "repo": args.github_pr,
            "interval_sec": parse_duration(args.interval or "180s")
        }
    elif args.github_issue:
        trigger = {
            "type": "github_issue",
            "repo": args.github_issue,
            "interval_sec": parse_duration(args.interval or "180s")
        }
    elif args.watch_file:
        trigger = {
            "type": "watch_file",
            "path": os.path.abspath(args.watch_file),
            "interval_sec": parse_duration(args.interval or "15s")
        }
    elif args.battery_below:
        trigger = {
            "type": "battery",
            "below_level": int(args.battery_below),
            "interval_sec": parse_duration(args.interval or "300s")
        }
    elif args.webhook_port:
        trigger = {
            "type": "webhook",
            "port": int(args.webhook_port),
            "token": args.webhook_token or secrets.token_urlsafe(32)
        }
    else:
        err = {"error": "Missing trigger. Provide --delay, --interval, --cron, --github-pr, --github-issue, --watch-file, --battery-below, or --webhook-port"}
        if getattr(args, "json", False):
            print(json.dumps(err))
        else:
            print(f"[agy-daemon] error: {err['error']}")
        sys.exit(1)

    new_task = {
        "id": task_id,
        "name": args.name or task_id,
        "command": args.command or "",
        "prompt": args.prompt or "",
        "project": args.project or "",
        "conversation_id": args.conversation_id or os.environ.get("AGY_CONVERSATION_ID", ""),
        "wake_app": args.wake_app or False,
        "trigger": trigger,
        "enabled": True,
        "created_at": time.time()
    }
    tasks.append(new_task)
    save_tasks(tasks)
    if getattr(args, "json", False):
        print(json.dumps({"status": "success", "task": new_task}, indent=2))
    else:
        print(f"[agy-daemon] Task added: {new_task['name']} (ID: {task_id})")
        if trigger.get("type") == "webhook":
            print(f"[agy-daemon] POST http://127.0.0.1:{trigger['port']}/")
            print(f"[agy-daemon] Include header X-AGY-Token: {trigger['token']}")


def cmd_task_list(args):
    tasks = load_tasks()
    if getattr(args, "active_only", False):
        tasks = [t for t in tasks if t.get("enabled", True)]

    if getattr(args, "json", False):
        print(json.dumps(tasks, indent=2))
        return

    print(f"Total scheduled tasks: {len(tasks)}")
    for t in tasks:
        status = "Active" if t.get("enabled") else "Disabled"
        last_st = t.get("last_run_status", "never")
        print(f"- [{t['id']}] {t.get('name')} | Status: {status} | Last: {last_st}")
        print(f"  Trigger: {t.get('trigger', {}).get('type')} ({t.get('trigger', {})})")
        if t.get("command"):
            print(f"  Command: {t.get('command')}")
        if t.get("prompt"):
            print(f"  AI Prompt: {t.get('prompt')}")
        if t.get("project"):
            print(f"  Project: {t.get('project')}")


def cmd_task_remove(args):
    tasks = load_tasks()
    initial_len = len(tasks)
    tasks = [t for t in tasks if t.get("id") != args.id and t.get("name") != args.id]
    if len(tasks) < initial_len:
        save_tasks(tasks)
        msg = f"Task removed: {args.id}"
        if getattr(args, "json", False):
            print(json.dumps({"status": "success", "message": msg}))
        else:
            print(f"[agy-daemon] {msg}")
    else:
        msg = f"Task not found: {args.id}"
        if getattr(args, "json", False):
            print(json.dumps({"status": "error", "message": msg}))
        else:
            print(f"[agy-daemon] {msg}")


def cmd_task_pause(args):
    tasks = load_tasks()
    found = False
    for t in tasks:
        if t.get("id") == args.id or t.get("name") == args.id:
            t["enabled"] = False
            found = True
            break
    if found:
        save_tasks(tasks)
        msg = f"Task paused: {args.id}"
        if getattr(args, "json", False):
            print(json.dumps({"status": "success", "message": msg}))
        else:
            print(f"[agy-daemon] {msg}")
    else:
        msg = f"Task not found: {args.id}"
        if getattr(args, "json", False):
            print(json.dumps({"status": "error", "message": msg}))
        else:
            print(f"[agy-daemon] {msg}")


def cmd_task_resume(args):
    tasks = load_tasks()
    found = False
    for t in tasks:
        if t.get("id") == args.id or t.get("name") == args.id:
            t["enabled"] = True
            t["executed"] = False
            found = True
            break
    if found:
        save_tasks(tasks)
        msg = f"Task resumed: {args.id}"
        if getattr(args, "json", False):
            print(json.dumps({"status": "success", "message": msg}))
        else:
            print(f"[agy-daemon] {msg}")
    else:
        msg = f"Task not found: {args.id}"
        if getattr(args, "json", False):
            print(json.dumps({"status": "error", "message": msg}))
        else:
            print(f"[agy-daemon] {msg}")


def cmd_task_run_now(args):
    tasks = load_tasks()
    target_task = None
    for t in tasks:
        if t.get("id") == args.id or t.get("name") == args.id:
            target_task = t
            break
    if not target_task:
        msg = f"Task not found: {args.id}"
        if getattr(args, "json", False):
            print(json.dumps({"status": "error", "message": msg}))
        else:
            print(f"[agy-daemon] {msg}")
        return

    print(f"[agy-daemon] Triggering immediate run for task [{target_task['id']}]...")
    execute_action_async(target_task)
    if getattr(args, "json", False):
        print(json.dumps({"status": "triggered", "id": target_task["id"]}))


def cmd_task_logs(args):
    tasks = load_tasks()
    for t in tasks:
        if t.get("id") == args.id or t.get("name") == args.id:
            print(f"Task: {t.get('name')} [{t['id']}]")
            print(f"Last Status:   {t.get('last_run_status', 'none')}")
            print(f"Last Duration: {t.get('last_run_duration', 0)}s")
            print(f"Last Run Time: {time.ctime(t.get('last_run_ts', 0)) if t.get('last_run_ts') else 'never'}")
            print("Last Output:")
            print(t.get("last_output", "(no output recorded)"))
            return
    print(f"[agy-daemon] Task not found: {args.id}")


def cmd_clear(args):
    save_tasks([])
    if getattr(args, "json", False):
        print(json.dumps({"status": "cleared"}))
    else:
        print("[agy-daemon] All scheduled tasks cleared.")


# -----------------------------------------------------------------------------
# CLI Entrypoint
# -----------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(description="Antigravity Autonomous Background Daemon & Task Manager")
    subparsers = parser.add_subparsers(dest="subcommand")

    # Service lifecycle
    p_start = subparsers.add_parser("start", help="Start background daemon service")
    p_start.add_argument("--foreground", "-f", action="store_true", help="Run in foreground for debugging")

    subparsers.add_parser("stop", help="Stop background daemon service")
    subparsers.add_parser("restart", help="Restart background daemon service")
    subparsers.add_parser("status", help="Get daemon service status and recent logs")

    # Direct task operations (backward compatible & shortcut)
    p_add = subparsers.add_parser("add", help="Schedule a new task (shortcut)")
    p_add.add_argument("--name", help="Task name")
    p_add.add_argument("--command", help="Shell command to execute")
    p_add.add_argument("--prompt", help="AI prompt to execute when triggered")
    p_add.add_argument("--project", help="Workspace project directory path")
    p_add.add_argument("--conversation-id", help="Conversation ID context")
    p_add.add_argument("--delay", help="Execute after duration, e.g. 4h, 30m, 60s")
    p_add.add_argument("--interval", help="Execute periodically, e.g. 15m, 1h")
    p_add.add_argument("--cron", help="Execute via standard 5-field cron, e.g. '0 3 * * *'")
    p_add.add_argument("--github-pr", help="Watch GitHub repo for new PRs, e.g. user/repo")
    p_add.add_argument("--github-issue", help="Watch GitHub repo for new issues, e.g. user/repo")
    p_add.add_argument("--watch-file", help="Watch file or directory path for changes")
    p_add.add_argument("--battery-below", help="Trigger when battery percentage falls below value")
    p_add.add_argument("--webhook-port", help="Start HTTP webhook receiver on port")
    p_add.add_argument("--webhook-token", help="Optional webhook token (generated when omitted)")
    p_add.add_argument("--wake-app", action="store_true", help="Bring Antigravity UI to front when task finishes")
    p_add.add_argument("--json", action="store_true", help="Output result as JSON")

    p_list = subparsers.add_parser("list", help="List scheduled tasks (shortcut)")
    p_list.add_argument("--json", action="store_true", help="Output as JSON")
    p_list.add_argument("--active-only", action="store_true", help="List only active tasks")

    p_remove = subparsers.add_parser("remove", help="Remove task by id or name (shortcut)")
    p_remove.add_argument("id", help="Task ID or name")
    p_remove.add_argument("--json", action="store_true", help="Output as JSON")

    p_clear = subparsers.add_parser("clear", help="Clear all scheduled tasks")
    p_clear.add_argument("--json", action="store_true", help="Output as JSON")

    # Dedicated Task Manager submodule
    p_task = subparsers.add_parser("task", help="Autonomous AI Task Manager")
    task_subs = p_task.add_subparsers(dest="task_cmd")

    pt_add = task_subs.add_parser("add", help="Add new task")
    pt_add.add_argument("--name", help="Task name")
    pt_add.add_argument("--command", help="Shell command to execute")
    pt_add.add_argument("--prompt", help="AI prompt to execute when triggered")
    pt_add.add_argument("--project", help="Workspace project directory path")
    pt_add.add_argument("--conversation-id", help="Conversation ID context")
    pt_add.add_argument("--delay", help="Execute after duration, e.g. 4h, 30m, 60s")
    pt_add.add_argument("--interval", help="Execute periodically, e.g. 15m, 1h")
    pt_add.add_argument("--cron", help="Execute via standard 5-field cron, e.g. '0 3 * * *'")
    pt_add.add_argument("--github-pr", help="Watch GitHub repo for new PRs, e.g. user/repo")
    pt_add.add_argument("--github-issue", help="Watch GitHub repo for new issues, e.g. user/repo")
    pt_add.add_argument("--watch-file", help="Watch file or directory path for changes")
    pt_add.add_argument("--battery-below", help="Trigger when battery percentage falls below value")
    pt_add.add_argument("--webhook-port", help="Start HTTP webhook receiver on port")
    pt_add.add_argument("--webhook-token", help="Optional webhook token (generated when omitted)")
    pt_add.add_argument("--wake-app", action="store_true", help="Bring Antigravity UI to front when task finishes")
    pt_add.add_argument("--json", action="store_true", help="Output result as JSON")

    pt_list = task_subs.add_parser("list", help="List tasks")
    pt_list.add_argument("--json", action="store_true", help="Output as JSON")
    pt_list.add_argument("--active-only", action="store_true", help="List only active tasks")

    pt_rm = task_subs.add_parser("remove", help="Remove task")
    pt_rm.add_argument("id", help="Task ID or name")
    pt_rm.add_argument("--json", action="store_true", help="Output as JSON")

    pt_pause = task_subs.add_parser("pause", help="Pause task")
    pt_pause.add_argument("id", help="Task ID or name")
    pt_pause.add_argument("--json", action="store_true", help="Output as JSON")

    pt_resume = task_subs.add_parser("resume", help="Resume task")
    pt_resume.add_argument("id", help="Task ID or name")
    pt_resume.add_argument("--json", action="store_true", help="Output as JSON")

    pt_run = task_subs.add_parser("run-now", help="Run task immediately")
    pt_run.add_argument("id", help="Task ID or name")
    pt_run.add_argument("--json", action="store_true", help="Output as JSON")

    pt_logs = task_subs.add_parser("logs", help="Get execution logs for task")
    pt_logs.add_argument("id", help="Task ID or name")

    args = parser.parse_args()

    if args.subcommand == "start":
        cmd_start(args)
    elif args.subcommand == "stop":
        cmd_stop(args)
    elif args.subcommand == "restart":
        cmd_stop(args)
        time.sleep(1)
        cmd_start(args)
    elif args.subcommand == "status":
        cmd_status(args)
    elif args.subcommand == "add":
        cmd_task_add(args)
    elif args.subcommand == "list":
        cmd_task_list(args)
    elif args.subcommand == "remove":
        cmd_task_remove(args)
    elif args.subcommand == "clear":
        cmd_clear(args)
    elif args.subcommand == "task":
        if args.task_cmd == "add":
            cmd_task_add(args)
        elif args.task_cmd == "list":
            cmd_task_list(args)
        elif args.task_cmd == "remove":
            cmd_task_remove(args)
        elif args.task_cmd == "pause":
            cmd_task_pause(args)
        elif args.task_cmd == "resume":
            cmd_task_resume(args)
        elif args.task_cmd == "run-now":
            cmd_task_run_now(args)
        elif args.task_cmd == "logs":
            cmd_task_logs(args)
        else:
            p_task.print_help()
    else:
        parser.print_help()


if __name__ == "__main__":
    main()
